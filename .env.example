# Spotify Developer Dashboard → your LiveStats app
SPOTIFY_CLIENT_ID=b22bcb87332f4d32afc822394b1ce881
SPOTIFY_CLIENT_SECRET=

# After you Connect once on /owner, paste the refresh token here so the
# PUBLIC site can show YOUR listening stats to visitors (no login for them).
SPOTIFY_REFRESH_TOKEN=

# Random string for signing session cookies (any long secret)
AUTH_SECRET=

# Public site URL (no trailing slash). Used to build the OAuth redirect URI.
# Local:  http://127.0.0.1:43127
# Vercel: https://livestats-mtm26.vercel.app
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43127
